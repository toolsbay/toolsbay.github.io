---
import { SUPPORTED_LANGUAGES, translations } from '../i18n/translations';

interface Props {
  currentLang?: string;
}

const { currentLang = 'en' } = Astro.props;
const t = translations[currentLang] || translations.en;
const currentLangConfig = SUPPORTED_LANGUAGES.find((l) => l.code === currentLang) || SUPPORTED_LANGUAGES[0];
---

<header class="sticky top-0 z-50 w-full glass-nav-light dark:glass-nav-dark transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-2 sm:gap-4">
      
      <!-- Brand & Badge -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a 
          href={currentLangConfig.path} 
          class="group flex items-center gap-2 text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-moss/60 rounded-xl"
          aria-label="ToolsBay Home"
        >
          <!-- Logo Icon -->
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-moss to-moss-600 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform duration-200 border border-moss-400/30">
            <svg class="w-5 h-5 text-sand" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>

          <div class="flex flex-col">
            <span class="text-base sm:text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-50 flex items-center gap-1.5">
              ToolsBay
              <!-- Verified dot -->
              <span class="inline-block w-2 h-2 rounded-full bg-sage animate-pulse"></span>
            </span>
            <span class="hidden md:inline-block text-[11px] font-medium text-olive-600 dark:text-olive-300">
              zero-server toolbox
            </span>
          </div>
        </a>

        <!-- 55+ Zero-Server Tools Badge (Desktop only) -->
        <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-sand-100 dark:bg-dark-card border border-sand-300/60 dark:border-sand/20 text-olive-700 dark:text-sand text-xs font-semibold">
          <svg class="w-3.5 h-3.5 text-moss dark:text-sand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>{t.badge55}</span>
        </div>
      </div>

      <!-- Center: Quick Search Trigger Hint (Desktop only) -->
      <div class="hidden md:flex flex-1 max-w-sm justify-center">
        <button
          type="button"
          id="navbar-search-trigger"
          class="w-full flex items-center justify-between px-3.5 py-1.5 rounded-xl text-xs text-neutral-500 dark:text-neutral-400 bg-white/70 dark:bg-dark-card/90 border border-light-border dark:border-dark-border hover:border-moss/40 dark:hover:border-sand/40 shadow-sm transition-all group"
          aria-label={t.searchAriaLabel}
        >
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-olive dark:text-sand group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span class="truncate">{t.searchPlaceholder.split('(')[0].trim()}</span>
          </span>
          <kbd class="hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 rounded border border-neutral-200 dark:border-neutral-700">
            <span class="text-xs">⌘</span>K
          </kbd>
        </button>
      </div>

      <!-- Right Nav Controls -->
      <div class="flex items-center gap-1.5 sm:gap-3">
        
        <!-- 7-Language Selector Dropdown -->
        <div class="relative" id="lang-dropdown-wrapper">
          <button
            type="button"
            id="lang-dropdown-btn"
            class="flex items-center gap-1.5 px-2 sm:px-3 py-1.5 rounded-xl text-xs font-semibold text-neutral-800 dark:text-neutral-200 bg-white/80 dark:bg-dark-card border border-light-border dark:border-dark-border hover:border-moss/40 dark:hover:border-sand/40 shadow-sm transition-all"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Language Selector"
          >
            <!-- Country Badge -->
            <span class="inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] font-mono font-bold rounded bg-sand/30 dark:bg-sand/20 text-olive-700 dark:text-sand border border-sand-300/40">
              {currentLangConfig.badge}
            </span>
            <!-- Full label only on desktop, collapsed to badge on mobile/tablet -->
            <span class="hidden sm:inline-block font-medium">{currentLangConfig.label}</span>
            <svg class="w-3.5 h-3.5 text-neutral-400 transition-transform duration-200" id="lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div
            id="lang-menu"
            class="hidden absolute right-0 mt-2 w-48 py-1.5 bg-white dark:bg-dark-surface rounded-2xl shadow-luxury-light dark:shadow-luxury-dark border border-light-border dark:border-dark-border z-50 animate-slide-down"
            role="menu"
            aria-orientation="vertical"
          >
            <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 border-b border-light-border/60 dark:border-dark-border/60">
              Languages
            </div>
            {SUPPORTED_LANGUAGES.map((lang) => {
              const isActive = lang.code === currentLang;
              return (
                <a
                  href={lang.path}
                  role="menuitem"
                  class={`flex items-center justify-between px-3 py-2 text-xs transition-colors ${
                    isActive
                      ? 'bg-moss/10 dark:bg-sand/10 text-moss dark:text-sand font-bold'
                      : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-dark-card font-normal'
                  }`}
                >
                  <span class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center w-6 h-4 text-[9px] font-mono font-bold rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
                      {lang.badge}
                    </span>
                    <span>{lang.label}</span>
                  </span>
                  {isActive && (
                    <svg class="w-4 h-4 text-moss dark:text-sand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  )}
                </a>
              );
            })}
          </div>
        </div>

        <!-- Light/Dark Mode Switcher -->
        <button
          type="button"
          id="theme-toggle-btn"
          class="p-2 rounded-xl text-neutral-700 dark:text-neutral-200 bg-white/80 dark:bg-dark-card border border-light-border dark:border-dark-border hover:border-moss/40 dark:hover:border-sand/40 hover:bg-neutral-50 dark:hover:bg-dark-hover shadow-sm transition-all"
          aria-label="Toggle Theme"
          title="Toggle Light / Dark Mode"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg class="w-4 h-4 hidden dark:block text-sand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg class="w-4 h-4 block dark:hidden text-olive-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>

        <!-- Support the Developer CTA Button -->
        <a
          href="https://ko-fi.com/kishara"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-xl text-xs font-semibold text-neutral-900 bg-gradient-to-r from-sand to-sand-400 hover:from-sand-400 hover:to-sand shadow-sm hover:shadow-glow-sand transition-all duration-200 border border-sand-400/40 shrink-0"
          title="Support the Developer on Ko-fi"
          aria-label={t.supportDev}
        >
          <span class="text-sm leading-none">☕</span>
          <!-- Full label strictly collapses to icon on mobile/tablet -->
          <span class="hidden sm:inline-block font-semibold tracking-tight">{t.supportDev}</span>
        </a>

      </div>
    </div>
  </div>
</header>

<script>
  // Language dropdown toggle
  const langBtn = document.getElementById('lang-dropdown-btn');
  const langMenu = document.getElementById('lang-menu');
  const langChevron = document.getElementById('lang-chevron');

  if (langBtn && langMenu) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = langBtn.getAttribute('aria-expanded') === 'true';
      langBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      langMenu.classList.toggle('hidden');
      if (langChevron) {
        langChevron.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(180deg)';
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!langMenu.classList.contains('hidden') && !langBtn.contains(e.target as Node)) {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
        if (langChevron) langChevron.style.transform = 'rotate(0deg)';
      }
    });
  }

  // Navbar quick search trigger
  const navSearchTrigger = document.getElementById('navbar-search-trigger');
  if (navSearchTrigger) {
    navSearchTrigger.addEventListener('click', () => {
      const searchInput = document.getElementById('main-tool-search') as HTMLInputElement | null;
      if (searchInput) {
        searchInput.focus();
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  // Theme Toggle Logic
  const themeToggle = document.getElementById('theme-toggle-btn');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('toolsbay-theme', isDark ? 'dark' : 'light');
      } catch (e) {
        // LocalStorage access may be restricted
      }
    });
  }
</script>
